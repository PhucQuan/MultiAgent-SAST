# Gemini API Configuration
# You can use either GEMINI_API_KEY or GOOGLE_API_KEY from Google AI Studio.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Cache Configuration
CACHE_ENABLED=true
CACHE_DIR=.aegis_cache
CACHE_TTL_DAYS=30

# Analysis Configuration
MAX_ANALYSIS_DEPTH=5
ENABLE_AI_VERIFICATION=true
AEGIS_SCAN_TIMEOUT_MS=3600000

# Rate Limiting (requests per minute)
API_RATE_LIMIT=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=aegis_sast.log
