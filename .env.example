# AI Provider Selection
# Supported values: gemini, openai-compatible, ollama
LLM_PROVIDER=gemini

# Gemini API Configuration
# You can use either GEMINI_API_KEY or GOOGLE_API_KEY from Google AI Studio.
GEMINI_API_KEY=your_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Local OpenAI-Compatible Configuration (Ollama / LM Studio)
# Example for Ollama:
# LLM_PROVIDER=ollama
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
# OPENAI_COMPATIBLE_MODEL=qwen3:8b
# OPENAI_COMPATIBLE_API_KEY=ollama
#
# Example for LM Studio:
# LLM_PROVIDER=openai-compatible
# OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_COMPATIBLE_MODEL=qwen2.5-coder-14b-instruct
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_MODEL=qwen3:8b
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_TIMEOUT_SECONDS=120

# Cache Configuration
CACHE_ENABLED=true
CACHE_DIR=.aegis_cache
CACHE_TTL_DAYS=30

# Analysis Configuration
MAX_ANALYSIS_DEPTH=5
ENABLE_AI_VERIFICATION=true
AEGIS_SCAN_TIMEOUT_MS=3600000

# Rate Limiting (requests per minute)
API_RATE_LIMIT=60

# Logging
LOG_LEVEL=INFO
LOG_FILE=aegis_sast.log

# ---------------------------------------------------------------------------
# Multi-agent triage layer (package `ai/`) — NVIDIA NIM
# Lấy key miễn phí tại https://build.nvidia.com (dạng nvapi-xxxxx)
# ---------------------------------------------------------------------------
NVIDIA_API_KEY=nvapi-YOUR_KEY_HERE
# Tuỳ chọn: nhiều key cùng tài khoản, phân tách bằng dấu phẩy, xoay vòng để chia tải
# NVIDIA_API_KEYS=nvapi-KEY1,nvapi-KEY2
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Model routing per role
AEGIS_MODEL_HYPOTHESIS=nvidia/nemotron-3-super-120b-a12b
AEGIS_MODEL_AUDITOR=nvidia/nemotron-3-super-120b-a12b
AEGIS_MODEL_SKEPTIC=openai/gpt-oss-20b
AEGIS_MODEL_JUDGE=nvidia/nemotron-3-super-120b-a12b

# Fallback chain (khi model chính fail)
AEGIS_MODEL_FALLBACK=openai/gpt-oss-20b,nvidia/nemotron-3-ultra-550b-a55b

# Temperature per role
AEGIS_TEMP_HYPOTHESIS=0.0
AEGIS_TEMP_AUDITOR=0.0
AEGIS_TEMP_SKEPTIC=0.0
AEGIS_TEMP_JUDGE=0.0

# Runtime
AEGIS_MAX_TOKENS=8192
# Seed cố định để kết quả tái lập được
AEGIS_SEED=0
AEGIS_TIMEOUT_SEC=60
# Trần tổng thời gian LLM cho một finding
AEGIS_FINDING_BUDGET_SEC=1200
AEGIS_MAX_RETRIES=3
AEGIS_DEBATE_ROUND_MAX=3
# Bỏ qua Skeptic khi Auditor tự tin hơn ngưỡng này (0.99 = gần như luôn chạy)
AEGIS_SKIP_SKEPTIC_CONFIDENCE=0.99
AEGIS_CACHE_DIR=./cache/llm

# ---------------------------------------------------------------------------
# Chế độ chạy tầng AI (kế hoạch nâng cấp, mục 3.2)
# disabled    - không gọi LLM, chỉ static SAST
# heuristic   - chỉ chạy filter tất định, không tốn API
# shadow      - chạy AI và ghi log nhưng KHÔNG đổi output chính  (mặc định)
# review-only - AI tóm tắt evidence, không tự gắn verdict
# active      - AI được gắn verdict theo policy
# ---------------------------------------------------------------------------
AEGIS_AI_MODE=shadow

# Eligibility gate — chặn trước khi tốn một token nào
AEGIS_MIN_SEVERITY_FOR_LLM=medium
AEGIS_MAX_LLM_FINDINGS_PER_SCAN=20
AEGIS_MAX_LLM_FINDINGS_PER_FILE=3
AEGIS_MIN_EVIDENCE_QUALITY_FOR_LLM=0.3

# Ngân sách cho MỘT finding
AEGIS_TOOL_CALL_BUDGET=4
AEGIS_TOKEN_BUDGET=3500

# Policy chống suppress sai. Ba giá trị mặc định dưới đây là lưới an toàn:
# đổi chúng nghĩa là chấp nhận rủi ro giấu nhầm một lỗ hổng thật.
AEGIS_REQUIRE_EVIDENCE_CITATIONS=true
AEGIS_REQUIRE_STATIC_VALIDATION_FOR_FP=true
AEGIS_HIGH_CRITICAL_AUTO_SUPPRESS=false

# Provenance — đổi bất kỳ giá trị nào cũng làm cache cũ hết hiệu lực
AEGIS_PROMPT_VERSION=2026.09.1
AEGIS_GRAPH_VERSION=2026.09.1
AEGIS_KNOWLEDGE_VERSION=3.0.0
AEGIS_POLICY_VERSION=2026.09.1
